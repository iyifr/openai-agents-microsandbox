{
  "name": "openai-agents-msb",
  "version": "0.3.0",
  "description": "Drop-in run() replacement and sandbox tools that give @openai/agents agents an isolated microsandbox workspace.",
  "license": "MIT",
  "author": "iyifr",
  "homepage": "https://github.com/iyifr/model-sandbox-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyifr/model-sandbox-tools.git",
    "directory": "packages/openai-agents"
  },
  "bugs": {
    "url": "https://github.com/iyifr/model-sandbox-tools/issues"
  },
  "keywords": [
    "openai-agents",
    "microsandbox",
    "sandbox",
    "ai-agents",
    "llm",
    "tools",
    "code-interpreter"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "microsandbox": ">=0.7.7 <0.8.0"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.12.0 <0.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@openai/agents": "^0.12.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "zod": "^4.0.0"
  }
}
